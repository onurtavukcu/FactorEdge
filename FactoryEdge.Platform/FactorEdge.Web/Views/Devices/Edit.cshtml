@using FactorEdge.Domain.Enums
@model FactorEdge.Application.DTOs.Devices.UpdateDeviceRequest

@{
    ViewData["Title"] = "Cihaz Düzenle";
}

<h2>Cihaz Düzenle</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Cihaz Kodu</label>
        <input asp-for="DeviceCode"
               class="form-control"
               readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Protocol" class="form-label"></label>
        <select asp-for="Protocol"
                asp-items="Html.GetEnumSelectList<DeviceProtocol>()"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Host" class="form-label"></label>
        <input asp-for="Host" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Port" class="form-label"></label>
        <input asp-for="Port" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="UnitId" class="form-label"></label>
        <input asp-for="UnitId" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="RegisterMapJson" class="form-label"></label>
        <textarea asp-for="RegisterMapJson"
                  class="form-control"
                  rows="4"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Topic" class="form-label"></label>
        <input asp-for="Topic" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">
            Aktif
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Güncelle
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        İptal
    </a>
</form>