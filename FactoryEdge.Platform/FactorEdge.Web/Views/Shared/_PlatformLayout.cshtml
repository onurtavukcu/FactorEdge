@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var userName = User.Identity?.Name ?? "SuperAdmin";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - FactorEdge Platform</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/factoredge.css"
          asp-append-version="true" />
</head>
<body>

    <div class="fe-shell">

        <aside class="fe-sidebar">

            <a asp-controller="Platform"
               asp-action="Index"
               class="fe-brand">

                <div class="fe-brand-icon">
                    <i class="bi bi-cpu"></i>
                </div>

                <div>
                    <div class="fe-brand-title">FactorEdge</div>
                    <div class="fe-brand-subtitle">Platform</div>
                </div>
            </a>

            
        <nav>
            <div class="fe-menu-label">PLATFORM</div>

            <a asp-controller="Platform"
               asp-action="Dashboard"
               class="fe-nav-link @(controller == "Platform" && action == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2 fe-nav-icon"></i>
                Dashboard
            </a>

            <a asp-controller="Platform"
               asp-action="Index"
               class="fe-nav-link @(controller == "Platform" && (action == "Index" || action == "Details" || action == "Edit") ? "active" : "")">
                <i class="bi bi-buildings fe-nav-icon"></i>
                Tenant Yönetimi
            </a>

            <a asp-controller="Platform"
               asp-action="Create"
               class="fe-nav-link @(controller == "Platform" && action == "Create" ? "active" : "")">
                <i class="bi bi-plus-square fe-nav-icon"></i>
                Yeni Tenant
            </a>
        </nav>


            <div class="fe-sidebar-bottom">
                <i class="bi bi-shield-check me-2"></i>
                Platform yönetim paneli
            </div>
        </aside>

        <div class="fe-main">

            <header class="fe-topbar">

                <div>
                    <div class="fe-topbar-title">
                        @ViewData["Title"]
                    </div>

                    <div class="fe-topbar-subtitle">
                        FactorEdge Platform Yönetimi
                    </div>
                </div>

                <div class="fe-topbar-right">

                    <div class="fe-user-avatar">
                        <i class="bi bi-person-gear"></i>
                    </div>

                    <div class="d-none d-md-block">
                        <div class="fe-user-name">@userName</div>
                        <div class="fe-user-role">SuperAdmin</div>
                    </div>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="ms-2">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i>
                            Çıkış
                        </button>
                    </form>

                </div>
            </header>

            <main class="fe-content">

                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success">@success</div>
                }

                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger">@error</div>
                }

                @RenderBody()

            </main>
        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
