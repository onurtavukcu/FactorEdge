
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var userName = User.Identity?.Name ?? "Kullanıcı";
    var isTenantAdmin = User.IsInRole("TenantAdmin");
    var userRole = isTenantAdmin ? "TenantAdmin" : "RegularUser";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - FactorEdge</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/factoredge.css"
          asp-append-version="true" />
</head>

<body>

    <div class="fe-shell">

        <aside class="fe-sidebar">

            <a asp-controller="Home"
               asp-action="Index"
               class="fe-brand">

                <div class="fe-brand-icon">
                    <i class="bi bi-cpu"></i>
                </div>

                <div>
                    <div class="fe-brand-title">FactorEdge</div>
                    <div class="fe-brand-subtitle">Factory Management</div>
                </div>
            </a>

            <nav>
                <div class="fe-menu-label">GENEL</div>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="fe-nav-link @(controller == "Home" ? "active" : "")">
                    <i class="bi bi-speedometer2 fe-nav-icon"></i>
                    Dashboard
                </a>

              <div class="fe-menu-label">FABRİKA</div>

            <a asp-controller="Devices"
               asp-action="Index"
               class="fe-nav-link @(controller == "Devices" ? "active" : "")">
                <i class="bi bi-cpu fe-nav-icon"></i>
                Cihazlar
            </a>

            <a asp-controller="Camera"
               asp-action="Index"
               class="fe-nav-link @(controller == "Camera" ? "active" : "")">
                <i class="bi bi-camera-video fe-nav-icon"></i>
                Kameralar
            </a>

                @* Telemetri sayfası eklendiğinde açılabilir.

                <a asp-controller="Telemetry"
                   asp-action="Index"
                   class="fe-nav-link @(controller == "Telemetry" ? "active" : "")">
                    <i class="bi bi-activity fe-nav-icon"></i>
                    Telemetri
                </a>
                *@

                @if (isTenantAdmin)
                {
                    <div class="fe-menu-label">YÖNETİM</div>

                    <a asp-controller="Users"
                       asp-action="Index"
                       class="fe-nav-link @(controller == "Users" ? "active" : "")">
                        <i class="bi bi-people fe-nav-icon"></i>
                        Kullanıcı Yönetimi
                    </a>
                }

            </nav>

            <div class="fe-sidebar-bottom">
                <i class="bi bi-hdd-network me-2"></i>
                FactorEdge Factory Platform
            </div>

        </aside>

        <div class="fe-main">

            <header class="fe-topbar">

                <div>
                    <div class="fe-topbar-title">
                        @ViewData["Title"]
                    </div>

                    <div class="fe-topbar-subtitle">
                        Fabrika yönetim paneli
                    </div>
                </div>

                <div class="fe-topbar-right">

                    <div class="fe-user-avatar">
                        <i class="bi bi-person"></i>
                    </div>

                    <div class="d-none d-md-block">
                        <div class="fe-user-name">@userName</div>
                        <div class="fe-user-role">@userRole</div>
                    </div>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="ms-2">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i>
                            Çıkış
                        </button>
                    </form>

                </div>

            </header>

            <main class="fe-content">

                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success">
                        @success
                    </div>
                }

                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger">
                        @error
                    </div>
                }

                @RenderBody()

            </main>

        </div>

    </div>

    @* Motor sıcaklığı alarm bildirim alanı *@

    @if (User.IsInRole("TenantAdmin") || User.IsInRole("RegularUser"))
    {
        <div id="feTemperatureToastContainer"
             style="position:fixed;
                    top:20px;
                    right:20px;
                    z-index:10900;
                    width:min(390px,calc(100vw - 40px));">
        </div>
    }

    @* JavaScript kütüphaneleri.
       Sayfalara ait Scripts bölümünden ÖNCE yüklenmeliler. *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            asp-fallback-src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"
            asp-fallback-test="window.signalR">
    </script>

    @* Motor sıcaklığı alarmı *@

    @if (User.IsInRole("TenantAdmin") || User.IsInRole("RegularUser"))
    {
        <script>
            (() => {
                const tenantId = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        User.FindFirst("tenantId")?.Value ?? ""));

                const endpoint = "/temperature-alerts/active";

                const container = document.getElementById(
                    "feTemperatureToastContainer"
                );

                if (!tenantId || !container)
                    return;

                let busy = false;

                function showToast(alert) {
                    const toast = document.createElement("div");

                    toast.style.cssText = [
                        "background:#fff",
                        "color:#202124",
                        "border:1px solid #f5b9b9",
                        "border-left:5px solid #dc3545",
                        "border-radius:10px",
                        "padding:16px",
                        "margin-bottom:12px",
                        "box-shadow:0 8px 25px rgba(0,0,0,.15)"
                    ].join(";");

                    const title = document.createElement("div");

                    title.style.cssText =
                        "font-weight:700;" +
                        "margin-bottom:8px;" +
                        "color:#b42318";

                    title.textContent = "⚠ Motor Sıcaklığı Alarmı";

                    const description = document.createElement("div");

                    description.style.marginBottom = "8px";

                    description.textContent =
                        `${alert.deviceName} (${alert.deviceCode})`;

                    const details = document.createElement("div");

                    details.textContent =
                        `Sıcaklık: ${Number(alert.temperature).toFixed(1)} °C ` +
                        `| Eşik: ${alert.threshold} °C`;

                    const close = document.createElement("button");

                    close.type = "button";
                    close.textContent = "Kapat";

                    close.style.cssText =
                        "margin-top:12px;" +
                        "border:0;" +
                        "background:#dc3545;" +
                        "color:white;" +
                        "border-radius:5px;" +
                        "padding:5px 12px;" +
                        "cursor:pointer";

                    close.addEventListener("click", () => {
                        toast.remove();
                    });

                    toast.append(
                        title,
                        description,
                        details,
                        close
                    );

                    container.prepend(toast);

                    // Ekranda en fazla üç bildirim bulunsun.
                    while (container.children.length > 3) {
                        container.lastElementChild.remove();
                    }

                    // Bildirim 15 saniye sonra kapanır.
                    setTimeout(() => {
                        toast.remove();
                    }, 15000);
                }

                async function checkAlerts() {
                    if (busy || document.hidden)
                        return;

                    busy = true;

                    try {
                        const response = await fetch(endpoint, {
                            credentials: "same-origin",
                            cache: "no-store"
                        });

                        if (!response.ok)
                            return;

                        const alerts = await response.json();

                        for (const alert of alerts) {
                            if (!alert.changedAtUtc)
                                continue;

                            const key =
                                `fe:alarm:${tenantId}:${alert.deviceId}`;

                            const version = alert.changedAtUtc;

                            if (sessionStorage.getItem(key) === version)
                                continue;

                            sessionStorage.setItem(key, version);

                            showToast(alert);
                        }
                    }
                    catch (error) {
                        console.warn(
                            "Sıcaklık alarmları okunamadı:",
                            error
                        );
                    }
                    finally {
                        busy = false;
                    }
                }

                checkAlerts();

                setInterval(checkAlerts, 3000);

                document.addEventListener(
                    "visibilitychange",
                    () => {
                        if (!document.hidden) {
                            checkAlerts();
                        }
                    }
                );
            })();
        </script>
    }

    @* Home/Index ve Devices/Index SignalR kodları burada çalışır. *@

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
