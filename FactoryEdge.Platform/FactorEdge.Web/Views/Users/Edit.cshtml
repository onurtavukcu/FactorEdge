@model FactorEdge.Application.Features.Users.Models.UpdateRegularUserRequest

@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="container mt-4">

    <h2 class="mb-4">Kullanıcı Düzenle</h2>

    <div class="card">
        <div class="card-body">

            <form asp-controller="Users"
                  asp-action="Edit"
                  asp-route-id="@Model.UserId"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="UserId" type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UserName"
                           class="form-label">
                        Kullanıcı Adı
                    </label>

                    <input asp-for="UserName"
                           class="form-control" />

                    <span asp-validation-for="UserName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email"
                           class="form-label">
                        E-posta
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Kullanıcı aktif
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Değişiklikleri Kaydet
                    </button>

                    <a asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-secondary">
                        İptal
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>
