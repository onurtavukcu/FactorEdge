@model FactorEdge.Application.Features.Users.Models.CreateRegularUserRequest

@{
    ViewData["Title"] = "Yeni Kullanıcı";
}

<div class="container mt-4">

    <h2 class="mb-4">Yeni Kullanıcı Oluştur</h2>

    <div class="card">
        <div class="card-body">

            <form asp-controller="Users"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">
                        Kullanıcı Adı
                    </label>

                    <input asp-for="UserName"
                           class="form-control" />

                    <span asp-validation-for="UserName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        E-posta
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">
                        Şifre
                    </label>

                    <input asp-for="Password"
                           type="password"
                           autocomplete="new-password"
                           class="form-control" />

                    <span asp-validation-for="Password"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Kullanıcı Oluştur
                    </button>

                    <a asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-secondary">
                        İptal
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>
