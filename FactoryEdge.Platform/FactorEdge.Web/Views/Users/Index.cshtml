@model IReadOnlyList<FactorEdge.Application.Features.Users.Models.RegularUserDto>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Kullanıcı Yönetimi</h2>

        <a asp-controller="Users"
           asp-action="Create"
           class="btn btn-primary">
            + Yeni Kullanıcı
        </a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">
            @success
        </div>
    }

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Kullanıcı Adı</th>
                <th>E-posta</th>
                <th>Durum</th>
                <th>Oluşturulma Tarihi</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>

                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                    </td>

                    <td>
                        @user.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td>
                        <a asp-controller="Users"
                           asp-action="Edit"
                           asp-route-id="@user.Id"
                           class="btn btn-sm btn-outline-primary">
                            Düzenle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Henüz kayıtlı kullanıcı bulunmuyor.
        </div>
    }

</div>
