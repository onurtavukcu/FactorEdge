@model IReadOnlyList<FactorEdge.Application.Features.Tenants.Models.TenantListDto>

@{
    ViewData["Title"] = "Tenant Yönetimi";
    bool isActive = ViewBag.IsActive ?? true;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Tenant Yönetimi</h2>

        <a asp-controller="Platform"
           asp-action="Create"
           class="btn btn-primary">
            + Yeni Tenant
        </a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <form asp-controller="Platform"
          asp-action="Index"
          method="get"
          class="d-flex align-items-center gap-3 mb-3">

        <div class="form-check mb-0">
            <input type="checkbox"
                   class="form-check-input"
                   id="isActive"
                   name="isActive"
                   value="true"
                   checked="@isActive" />

            <label class="form-check-label" for="isActive">
                Yalnızca aktif tenant'lar
            </label>
        </div>

        <input type="hidden" name="isActive" value="false" />

        <button type="submit" class="btn btn-outline-primary btn-sm">
            Listele
        </button>
    </form>

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Şirket</th>
                <th>Veritabanı</th>
                <th>Durum</th>
                <th>Oluşturulma Tarihi</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var tenant in Model)
            {
                <tr>
                    <td>@tenant.Name</td>

                    <td>@tenant.DatabaseName</td>

                    <td>
                        @if (tenant.Status == FactorEdge.Domain.Enums.TenantStatus.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else if (tenant.Status == FactorEdge.Domain.Enums.TenantStatus.Suspended)
                        {
                            <span class="badge bg-warning text-dark">Suspended</span>
                        }
                        else if (tenant.Status == FactorEdge.Domain.Enums.TenantStatus.Failed)
                        {
                            <span class="badge bg-danger">Failed</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@tenant.Status</span>
                        }
                    </td>

                    <td>
                        @tenant.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td>
                        <div class="d-flex gap-2">
                            <a asp-controller="Platform"
                               asp-action="Details"
                               asp-route-id="@tenant.Id"
                               class="btn btn-sm btn-outline-primary">
                                Detay
                            </a>

                            @if (tenant.Status is
                                FactorEdge.Domain.Enums.TenantStatus.Active or
                                FactorEdge.Domain.Enums.TenantStatus.Suspended)
                            {
                                <a asp-controller="Platform"
                                   asp-action="Edit"
                                   asp-route-id="@tenant.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Düzenle
                                </a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Gösterilecek tenant bulunamadı.
        </div>
    }
</div>
